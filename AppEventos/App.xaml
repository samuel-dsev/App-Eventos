<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppEventos.App">
    <Application.Resources>
        <Color x:Key="Fundo">#EEF2F8</Color>
        <Color x:Key="Texto">#162641</Color>
        <Color x:Key="TextoSecundario">#465873</Color>
        <Color x:Key="Borda">#D6DFED</Color>
        <Color x:Key="Azul">#244CB7</Color>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="AppRegular" />
            <Setter Property="TextColor" Value="{StaticResource Texto}" />
        </Style>
        <Style x:Key="Titulo" TargetType="Label">
            <Setter Property="FontFamily" Value="AppSemibold" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
        </Style>
        <Style x:Key="Legenda" TargetType="Label">
            <Setter Property="FontFamily" Value="AppSemibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource TextoSecundario}" />
        </Style>
        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="{StaticResource Borda}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="AppRegular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource Texto}" />
            <Setter Property="PlaceholderColor" Value="#566882" />
            <Setter Property="MinimumHeightRequest" Value="42" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="AppRegular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource Texto}" />
            <Setter Property="MinimumHeightRequest" Value="42" />
            <Setter Property="Format" Value="dd/MM/yyyy" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="AppSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BackgroundColor" Value="{StaticResource Azul}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>
    </Application.Resources>
</Application>
